{
  "name": "ossi-tv",
  "productName": "Ossi TV",
  "version": "1.4.0",
  "description": "Ossi TV for Windows",
  "author": "azadiapk-tech",
  "main": "main.js",
  "private": true,
  "scripts": {
    "page": "python page.py app/index.html",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "hls.js": "1.5.17",
    "mpegts.js": "1.7.3"
  },
  "dependencies": {
    "electron-updater": "latest"
  },
  "build": {
    "appId": "com.azadiapk.ossitv",
    "productName": "Ossi TV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ossi TV",
      "artifactName": "OssiTV-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/azadiapk-tech/ossi-tv/releases/download/windows"
      }
    ]
  }
}
